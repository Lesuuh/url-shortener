# Knot frontend — environment

All variables are optional. Vite reads them at build/dev time (VITE_* only).

# Marketing site origin — used for canonical URLs, Open Graph and structured
# data in the static HTML (defaults to https://knot.to).
# VITE_SITE_URL=https://knot.to

# App origin — where the app lives. The marketing hero demo uses this when it
# deep-links "Open in app". Defaults to "/app" (same origin).
# VITE_APP_URL=https://app.knot.to

# API base — where the marketing hero demo posts its shorten attempt.
# Defaults to "/api" (proxied by Vite in dev, same-origin in production).
# VITE_API_BASE=/api

# Short-link base — used to build full clickable short URLs. Defaults to
# http://localhost:5000 in dev and window.location.origin in production.
# VITE_SHORT_BASE=https://knot.to

# Dev proxy target for /api calls (VITE_BACKEND_TARGET) — only for `vite dev`.
# VITE_BACKEND_TARGET=http://localhost:5000
