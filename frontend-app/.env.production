# Production build-time env for the Knot app (Vercel: knot-links-app.vercel.app).
# Vite loads this file automatically when building (vite build).

# Backend API base — absolute so the app talks cross-origin to the Render API.
VITE_API_BASE=https://knot-76o5.onrender.com/api

# The app's own origin (used for "Open in app" deep links).
VITE_APP_URL=https://knot-links-app.vercel.app

# Base for shareable short URLs — resolves at the Render backend which redirects.
VITE_SHORT_BASE=https://knot-76o5.onrender.com
