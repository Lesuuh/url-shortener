# Knot backend — environment
# Copy to .env and adjust.

PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/url_shortener_db?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"
RESEND_API_KEY="your-resend-api-key"

# Serve the built frontend (../frontend/dist) from Express — the "integrated"
# single-origin deployment. Auto-enabled when NODE_ENV=production.
# SERVE_FRONTEND=true

# Public origin used to build fullShortUrl in API responses.
# APP_DOMAIN="http://localhost:5000"
