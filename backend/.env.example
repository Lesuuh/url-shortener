# =====================================================================
# Knot backend — production environment
# Copy to .env (or set as host env vars on your deploy platform) and fill.
# =====================================================================

# Server port the API binds to.
PORT=5000

# PostgreSQL connection string (Aiven managed Postgres).
# For Aiven's self-signed cert, keep uselibpqcompat=true&sslmode=require in dev;
# for prod you may switch to sslmode=verify-full once the Aiven CA is trusted.
DATABASE_URL="postgres://USER:PASS@HOST:PORT/defaultdb?uselibpqcompat=true&sslmode=require"

# Production mode.
NODE_ENV="production"

# Long random secret for signing auth tokens (JWT).
JWT_SECRET="replace-with-a-long-random-string"

# Resend API key for transactional email (register/reset/password-changed).
RESEND_API_KEY="re_..."

# Public origin of the frontend app (used to build email links and reset
# URLs). For this deploy the app is on Vercel.
FRONTEND_URL="https://knot-links-app.vercel.app"

# Public origin used to build fullShortUrl in API responses — must equal the
# domain where short links resolve. The Render backend performs the redirect,
# so for now this is the Render origin (swap for a custom short domain later).
APP_DOMAIN="https://url-shortener-cftf.onrender.com"

# Serve the built frontend from Express (single-origin deployment).
# Not needed here — landing + app are on Vercel — so keep it off. Only used
# if you later serve the frontends from this backend.
SERVE_FRONTEND="false"

# CORS — allowed cross-origin frontends (comma-separated). Required because
# the Vercel frontends call the Render API cross-origin with credentials.
# Defaults to these two if unset.
CORS_ORIGINS="https://knot-links.vercel.app,https://knot-links-app.vercel.app"

# ---------------------------------------------------------------------
# Paystack (billing — PRO 3-month pass) — set once you implement BILLING.md
# ---------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
PRO_PRICE_KOBO="750000"
PRO_CURRENCY="NGN"
PRO_DURATION_MONTHS="3"
