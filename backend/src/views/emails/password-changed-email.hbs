<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Your password was changed</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f7f7f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f7f7f8; padding: 40px 16px;"
    >
      <tr>
        <td align="center">

          <!-- Main container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border: 1px solid #e4e4e9;
              border-radius: 12px;
              overflow: hidden;
            "
          >

            <!-- Brand accent strip -->
            <tr>
              <td style="height: 4px; background-color: #0e7a5b; font-size: 0; line-height: 4px;">
                &nbsp;
              </td>
            </tr>

            <!-- Header -->
            <tr>
              <td style="padding: 28px 32px; border-bottom: 1px solid #e4e4e9;">
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  <tr>
                    <td>
                      <div style="font-size: 20px; font-weight: 700; letter-spacing: -0.5px; color: #17171b;">
                        <span
                          style="
                            display: inline-block;
                            width: 28px;
                            height: 28px;
                            margin-right: 8px;
                            vertical-align: -5px;
                            border-radius: 7px;
                            background-color: #0e7a5b;
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            text-align: center;
                            line-height: 28px;
                          "
                        >k</span>
                        knot
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 32px 32px;">

                <p
                  style="
                    margin: 0 0 12px;
                    font-size: 12px;
                    font-weight: 700;
                    color: #0a5f47;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                  "
                >
                  Account security
                </p>

                <h1
                  style="
                    margin: 0 0 20px;
                    font-size: 30px;
                    line-height: 1.2;
                    letter-spacing: -0.8px;
                    font-weight: 800;
                    color: #17171b;
                  "
                >
                  Your password was changed
                </h1>

                <p
                  style="
                    margin: 0 0 20px;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #45454d;
                  "
                >
                  Hi
                  {{userName}},
                </p>

                <p
                  style="
                    margin: 0 0 20px;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #45454d;
                  "
                >
                  The password for your Knot account was just changed. If that was
                  you, you're all set — nothing else to do.
                </p>

                <!-- CTA -->
                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin: 28px 0;"
                >
                  <tr>
                    <td>
                      <a
                        href="{{appUrl}}"
                        style="
                          display: inline-block;
                          padding: 12px 22px;
                          background-color: #0e7a5b;
                          color: #ffffff;
                          font-size: 15px;
                          font-weight: 700;
                          text-decoration: none;
                          border-radius: 7px;
                        "
                      >
                        Go to your account
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #71717a;
                  "
                >
                  If you didn't make this change, reset your password from the
                  sign-in screen right away and contact support — someone else may
                  have accessed your account.
                </p>

              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 32px;">
                <div style="height: 1px; background-color: #e4e4e9;"></div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 24px 32px 30px;">
                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    line-height: 1.5;
                    color: #71717a;
                  "
                >
                  This email was sent because the password for your Knot account
                  was changed.
                </p>
                <p
                  style="
                    margin: 16px 0 0;
                    font-size: 12px;
                    line-height: 1.5;
                    color: #a1a1aa;
                  "
                >
                  © 2026 Knot · Short links that hold.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>