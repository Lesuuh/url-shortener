# Production build-time env for the Knot landing site (Vercel: knot-links.vercel.app).
# Vite loads this file automatically when building (vite build).

# Backend API base — absolute so the marketing hero demo posts cross-origin.
VITE_API_BASE=https://knot-76o5.onrender.com/api

# Where the app lives — "Open in app" / unauthenticated shorten deep-links.
VITE_APP_URL=https://knot-links-app.vercel.app

# Canonical site URL — injected into <head> (canonical, Open Graph).
VITE_SITE_URL=https://knot-links.vercel.app

# Base for shareable short URLs — resolves at the Render backend which redirects.
VITE_SHORT_BASE=https://knot-76o5.onrender.com
